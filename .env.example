# ── Database ─────────────────────────────────────────────
# Local (Docker):  postgresql://sharkpark:sharkpark@localhost:5433/sharkpark?schema=public
# Production:      Aurora PostgreSQL Serverless v2 connection string
DATABASE_URL=postgresql://sharkpark:sharkpark@localhost:5433/sharkpark?schema=public

# ── Auth (Azure AD / CSULB SSO) ─────────────────────────
AZURE_CLIENT_ID=9aea0ab1-4502-4868-a31b-0a8f333cec9c
AZURE_TENANT_ID=d175679b-acd3-4644-be82-af041982977a

# ── Security ─────────────────────────────────────────────
# Salt used for hashing device IDs (change in production!)
DEVICE_HASH_SALT=sharkpark-default-salt-2026

# Comma-separated list of allowed origins for CORS in production
# CORS_ORIGINS=https://sharkpark.example.com

# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── S3-compatible object storage ────────────────────────
# Local: MinIO (docker compose). Prod: Cloudflare R2.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=sharkpark
AWS_SECRET_ACCESS_KEY=sharkpark-local-dev
S3_ENDPOINT=http://localhost:9000
