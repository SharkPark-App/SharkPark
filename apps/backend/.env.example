# SharkPark backend — environment variables
# Copy to .env and fill in. .env is gitignored.

# ─── Required (production) ─────────────────────────────────────────────
# Postgres connection. Local: docker-compose service. Prod: Neon pooled URL.
DATABASE_URL="postgresql://sharkpark:sharkpark@localhost:5433/sharkpark?schema=public"

# Azure AD (CSULB SSO tenant). Required to validate JWTs in production.
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""

# Salt used to hash device ids before persistence. Generate with `openssl rand -hex 32`.
DEVICE_HASH_SALT="replace-me-with-openssl-rand-hex-32"

# HMAC-SHA256 secret used by mobile to sign occupancy events.
# Generate with `openssl rand -hex 32`. Must match mobile build.
DEVICE_EVENT_SECRET=""

# Shared secret for the shuttle WebSocket handshake.
# When unset, the gateway logs a warning and allows all connections.
# Generate with `openssl rand -hex 32`. Must match mobile build.
WS_CONNECT_SECRET=""

# ─── Optional ──────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# CORS allow-list (comma separated). Production only — dev allows all origins.
# Example: CORS_ORIGINS="https://sharkpark.app,https://app.sharkpark.app"
CORS_ORIGINS=""

# Redis connection URL (Fly Redis / upstash).
# Required for multi-instance prod. else local memory will be used.
REDIS_URL=""

# Read-replica URL (Neon read branch). Falls back to DATABASE_URL when unset.
DATABASE_URL_RO=""

# pino log level: trace|debug|info|warn|error|fatal. Default: debug (dev), info (prod).
LOG_LEVEL=""

# Minimum supported mobile app version returned by GET /api/v1/min-version.
# Strict MAJOR.MINOR.PATCH. When unset, defaults to "1.0.0" (and the service
# logs a warning at boot). Bump this to force-update users to a newer build —
# anything below this will see the blocking ForceUpdateScreen on launch.
MIN_SUPPORTED_APP_VERSION="1.0.0"

# Optional per-platform overrides, used when the App Store and Play Store are
# not in sync (e.g. Apple approves a critical fix before Google). Mobile sends
# `x-platform: ios|android` on every request; the backend picks the matching
# floor here, falling back to MIN_SUPPORTED_APP_VERSION above when the
# platform-specific value is unset. Old clients that pre-date the header (none
# at v1 launch — both stores ship 1.0.0 with the header) just get the global
# floor. Same strict MAJOR.MINOR.PATCH validation; a malformed value will
# crash the boot.
MIN_SUPPORTED_APP_VERSION_IOS=""
MIN_SUPPORTED_APP_VERSION_ANDROID=""

# ─── Sentry (optional) ─────────────────────────────────────────────────
# Backend project DSN. When unset, Sentry init is a no-op.
# Sentry → sharkpark org → sharkpark-backend project → Settings → Client Keys.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""

# ─── Weather (NWS api.weather.gov) ─────────────────────────────────────
# NWS is keyless and free but asks for a descriptive User-Agent so they can
# contact heavy API users. Use "<AppName>/<Version> (<contact-email>)".
WEATHER_USER_AGENT="SharkPark/1.0 (ops@sharkpark.app)"
WEATHER_LAT="33.7838"
WEATHER_LON="-118.1134"

# ─── Push notifications (Firebase Cloud Messaging) ─────────────────────
# When unset, NotificationsService logs a warning and push sending is disabled.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Leave any encoded newlines, as they're handled automatically.
FIREBASE_PRIVATE_KEY=""

# ─── Local infra only (LocalStack S3) ──────────────────────────────────
AWS_REGION="us-west-2"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
S3_ENDPOINT="http://localhost:4566"
