# SharkPark backend cron schedule (parsed by supercronic)
#
# Format: standard 5-field cron + command. supercronic also supports the
# 6-field (with seconds) and @hourly etc. macros.
#
# Times are interpreted in the container's TZ. We set TZ=America/Los_Angeles
# in fly.toml [processes.cron], so wall-clock entries below are PT.
#
# Each script is idempotent and acquires a Postgres advisory lock so a missed
# tick or overlapping run is safe.

# Snapshot occupancy from raw events → minute buckets. Every 15 min.
*/15 * * * *  node /app/apps/backend/dist/scripts/snapshot.js

# Fetch CSULB-area current weather from NWS api.weather.gov. Every 30 min.
*/30 * * * *  node /app/apps/backend/dist/scripts/fetch-weather.js

# Fetch the full ~6.5-day NWS hourly forecast. Every 6 hours — forecasts
# re-issue more often upstream but the marginal information is small at our
# resolution, and 6h keeps NWS request volume tiny.
0 */6 * * *   node /app/apps/backend/dist/scripts/fetch-weather-forecast.js

# Fetch routes, stops, and shuttle metadata from PassioGO!. Daily at 6 AM Pacific.
0 6 * * *     node /app/apps/backend/dist/scripts/fetch-transit.js

# Purge stale device-state rows. Daily at 3 AM Pacific.
0 3 * * *     node /app/apps/backend/dist/scripts/cleanup-device-states.js

# Stream pg_dump → R2 (sharkpark-backups/daily/YYYY-MM-DD.dump.gz). Daily at 2 AM Pacific.
0 2 * * *     node /app/apps/backend/dist/scripts/backup-db.js

# Verify newest backup parses cleanly. Mondays at 4 AM Pacific (after Sunday backup).
0 4 * * 1     node /app/apps/backend/dist/scripts/verify-latest-backup.js

# Prune raw occupancy_events older than RETENTION_DAYS (default 30, per the
# privacy promise in README.md). occupancy_snapshots are kept permanently.
# Daily at 4 AM Pacific, after the 2 AM backup so the deleted rows are
# present in the latest dump. Skips Mondays so it doesn't race
# verify-latest-backup; the next day's run catches up.
0 4 * * 0,2-6 node /app/apps/backend/dist/scripts/prune-old-data.js

# Delete campus_events whose end_time is older than EVENT_RETENTION_DAYS
# (default 90). Past events are filtered out of the API response already, so
# this is housekeeping for table + backup size. Mondays at 4:30 AM Pacific —
# 30 min after verify-latest-backup so deleted rows are present in the most
# recent verified dump.
30 4 * * 1    node /app/apps/backend/dist/scripts/prune-old-events.js

# Scrape campus events from CampusLabs and upsert into campus_events. Daily at 5 AM Pacific.
0 5 * * *     node /app/apps/backend/dist/scripts/fetch-events.js

# Scrape sports events from longbeachstate.com (Sidearm) and upsert into campus_events.
# Daily at 5:30 AM Pacific — staggered 30 min after fetch-events so the two scrapers
# don't bootstrap simultaneously on the cron VM.
30 5 * * *    node /app/apps/backend/dist/scripts/fetch-sports-events.js

# Push notification triggers — each runs every 15 min, matching the snapshot cadence.
# Requires FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY Fly secrets.
# Advisory lock prevents overlap; missing Firebase creds leads to a warning log.

# Favorite lot crosses 80% occupancy.
*/15 * * * *  node /app/apps/backend/dist/scripts/notify-favorites-filling.js

# Favorite lot drops below 30% after previously being above 75%.
*/15 * * * *  node /app/apps/backend/dist/scripts/notify-favorites-clearing.js

# Any lot exceeds 90% occupancy (campus-wide surge).
*/15 * * * *  node /app/apps/backend/dist/scripts/notify-surge.js

# CampusEvent starting within the next 2 hours.
*/15 * * * *  node /app/apps/backend/dist/scripts/notify-events.js

# Refresh lot advisories from concept3d (closure / construction overlay).
# Sundays at 6 AM Pacific — staggered after the 5 AM events scrapes so the
# external API hits don't bunch up. Geofences/buildings stay committed to
# the repo (rare changes need code review); this only refreshes advisories.
0 6 * * 0     node /app/apps/backend/dist/scripts/refresh-lot-advisories.js

# Reconcile lot metadata (EV presence) from concept3d. Monthly at 7 AM PT on the 1st.
0 7 1 * *     node /app/apps/backend/dist/scripts/refresh-lot-metadata.js
