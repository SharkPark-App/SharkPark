# SharkPark backend cron schedule (parsed by supercronic)
#
# Format: standard 5-field cron + command. supercronic also supports the
# 6-field (with seconds) and @hourly etc. macros.
#
# Times are interpreted in the container's TZ. We set TZ=America/Los_Angeles
# in fly.toml [processes.cron], so wall-clock entries below are PT.
#
# Each script is idempotent and acquires a Postgres advisory lock so a missed
# tick or overlapping run is safe.

# Snapshot occupancy from raw events → minute buckets. Every 15 min.
*/15 * * * *  node /app/apps/backend/dist/scripts/snapshot.js

# Fetch CSULB-area weather from OpenWeather. Every 30 min.
*/30 * * * *  node /app/apps/backend/dist/scripts/fetch-weather.js

# Fetch routes and stops from PassioGO!. Daily at 12 AM Pacific.
0 0 * * *     node /app/apps/backend/dist/scripts/fetch-routes-stops.js

# Purge stale device-state rows. Daily at 3 AM Pacific.
0 3 * * *     node /app/apps/backend/dist/scripts/cleanup-device-states.js

# Stream pg_dump → R2 (sharkpark-backups/daily/YYYY-MM-DD.dump.gz). Daily at 2 AM Pacific.
0 2 * * *     node /app/apps/backend/dist/scripts/backup-db.js

# Verify newest backup parses cleanly. Mondays at 4 AM Pacific (after Sunday backup).
0 4 * * 1     node /app/apps/backend/dist/scripts/verify-latest-backup.js

# Prune raw occupancy_events older than RETENTION_DAYS (default 30, per the
# privacy promise in README.md). occupancy_snapshots are kept permanently.
# Daily at 4 AM Pacific, after the 2 AM backup so the deleted rows are
# present in the latest dump. Skips Mondays so it doesn't race
# verify-latest-backup; the next day's run catches up.
0 4 * * 0,2-6 node /app/apps/backend/dist/scripts/prune-old-data.js
