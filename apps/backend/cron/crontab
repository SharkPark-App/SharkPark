# SharkPark backend cron schedule (parsed by supercronic)
#
# Format: standard 5-field cron + command. supercronic also supports the
# 6-field (with seconds) and @hourly etc. macros.
#
# Times are interpreted in the container's TZ. We set TZ=America/Los_Angeles
# in fly.toml [processes.cron], so wall-clock entries below are PT.
#
# Each script is idempotent and acquires a Postgres advisory lock so a missed
# tick or overlapping run is safe.

# Snapshot occupancy from raw events → minute buckets. Every 15 min.
*/15 * * * *  node /app/apps/backend/dist/scripts/snapshot.js

# Fetch CSULB-area weather from OpenWeather. Every 30 min.
*/30 * * * *  node /app/apps/backend/dist/scripts/fetch-weather.js

# Purge stale device-state rows. Daily at 3 AM Pacific.
0 3 * * *     node /app/apps/backend/dist/scripts/cleanup-device-states.js
