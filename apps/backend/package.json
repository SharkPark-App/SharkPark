{
  "name": "@sharkpark/backend",
  "version": "0.0.1",
  "private": true,
  "description": "SharkPark API (NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "build": "nest build -p tsconfig.build.json",
    "start:scheduler": "node dist/scheduler-main.js",
    "db:seed": "prisma db seed",
    "db:seed:prod": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-prod.ts",
    "db:seed:demo": "ts-node --project tsconfig.scripts.json --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/seed-demo-bootstrap.ts",
    "audit:lots": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/audit-lots.ts",
    "backfill:consensus": "ts-node --project tsconfig.scripts.json --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/backfill-consensus.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "jest --config ./jest.config.js",
    "test:e2e": "jest --config ./jest-e2e.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/lib-storage": "^3.1039.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.51.0",
    "bad-words": "^3.0.4",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "jwks-rsa": "^4.0.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/bad-words": "^3.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}