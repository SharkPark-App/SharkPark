// SharkPark PostgreSQL Schema — Aurora PostgreSQL Serverless v2 (local: Docker PostgreSQL 16)
// Migrated from DynamoDB single-table design to relational model with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core Tables ──────────────────────────────────────────

model School {
  id           String   @id @default(cuid())
  school_name  String   @unique
  short_name   String   @unique // e.g. "CSULB"
  timezone     String   @default("America/Los_Angeles")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lots              Lot[]
  users             User[]
  buildings         Building[]
  campus_events     CampusEvent[]
  weather           Weather[]
  weather_forecasts WeatherForecast[]
  lot_advisories    LotAdvisory[]

  @@map("schools")
}

model Lot {
  id                  String   @id @default(cuid())
  school_id           String
  lot_id              String   // e.g. "G1", "E7" — human-readable
  lot_name            String
  display_name        String
  lot_number          String
  lot_type            LotType
  capacity            Int
  current_occupancy   Int      @default(0)
  location_description String
  center_lat          Float
  center_lng          Float
  geofence_polygon    Json     // Array<{ lat: number; lng: number }>
  geofence_radius     Float
  permit_types        String[]
  daily_permit_allowed Boolean @default(false)
  daily_rate          Decimal? @db.Decimal(10, 2)
  hours_weekday       Json     // { open: string; close: string } | string
  hours_saturday      Json
  hours_sunday        Json
  ev_charging_stations Int     @default(0)
  motorcycle_spaces   Int      @default(0)
  accessible_spaces   Int      @default(0)
  /** Spaces dedicated to short-term/visitor parking (≤30 min metered or designated). */
  short_term_parking_spaces Int @default(0)
  /** Spaces designated for low-emission vehicles (signed but unenforced — count is informational). */
  low_emission_spaces Int      @default(0)
  /** Number of pay stations physically located in this lot. */
  pay_stations        Int      @default(0)
  has_lighting        Boolean  @default(true)
  has_cameras         Boolean  @default(false)
  has_emergency_phone Boolean  @default(false)
  is_covered          Boolean  @default(false)
  is_paved            Boolean  @default(true)
  /** True for multi-level parking structures (PVN/PVS/PYR at CSULB). */
  is_structure        Boolean  @default(false)
  /** True for surface lots with solar-panel canopies overhead (G6/G7/G8/E8 at CSULB). */
  has_solar_canopy    Boolean  @default(false)
  levels              Int?
  /// Quality grade of the static metadata (capacity, geofence, amenity counts, hours).
  /// NOT a runtime/ML signal — see OccupancySnapshot.confidence for the live grade.
  metadata_confidence ConfidenceLevel @default(LOW)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  school              School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user_favorites      UserFavorite[]
  occupancy_events    OccupancyEvent[]
  occupancy_snapshots OccupancySnapshot[]
  device_states       DeviceState[]
  predictions_short   PredictionShortTerm[]
  predictions_long    PredictionLongTerm[]
  reports             Report[]
  lot_buildings       LotBuilding[]
  lot_advisories      LotAdvisory[]
  notification_logs   NotificationLog[]

  @@unique([school_id, lot_id])
  @@index([lot_type], name: "idx_lots_type")
  @@map("lots")
}

model User {
  id             String   @id @default(cuid())
  school_id      String
  email          String   @unique
  first_name     String
  last_name      String
  user_type      UserType
  notification_preferences Json @default("{\"favorites_filling\":false,\"favorites_clearing\":false,\"surge_alerts\":false,\"event_alerts\":false}")
  created_at     DateTime @default(now())
  last_login     DateTime?
  updated_at     DateTime @updatedAt

  school             School             @relation(fields: [school_id], references: [id], onDelete: Cascade)
  favorites          UserFavorite[]
  reports            Report[]
  push_tokens        PushToken[]
  notification_logs  NotificationLog[]

  @@index([school_id])
  @@map("users")
}

model UserFavorite {
  id       String   @id @default(cuid())
  user_id  String
  lot_id   String
  added_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lot  Lot  @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lot_id])
  @@map("user_favorites")
}

// ─── Timeseries Tables ────────────────────────────────────

model OccupancyEvent {
  id                String           @id @default(cuid())
  lot_id            String
  event_type        EventType
  device_hash       String           // SHA-256 hash of device_id + salt
  timestamp         DateTime
  created_at        DateTime         @default(now())

  lot Lot @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@index([lot_id, timestamp], name: "idx_events_lot_time")
  @@index([device_hash, lot_id], name: "idx_events_device")
  @@index([timestamp, device_hash], name: "idx_events_time_device")
  @@map("occupancy_events")
}

model OccupancySnapshot {
  id                String          @id @default(cuid())
  lot_id            String
  timestamp         DateTime
  occupancy         Int
  available         Int
  occupancy_rate    Float
  confidence        ConfidenceLevel
  reliability_score Float?
  is_cold_start     Boolean?

  // Penetration rate estimation columns
  estimated_occupancy    Int?     // Scaled-up occupancy estimate
  penetration_rate_used  Float?   // Effective penetration rate at snapshot time

  // Weather context at snapshot time
  weather_id        String?

  // ML feature columns (populated at write time by academic-calendar.ts)
  semester          String?         // "fall", "spring", "summer", "session", "break"
  academic_period   String?         // "early", "regular", "midterms", "late", "dead_week", "finals", "break"
  week_of_semester  Int?
  is_campus_open    Boolean         @default(true)

  lot     Lot      @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  weather Weather? @relation(fields: [weather_id], references: [id], onDelete: SetNull)

  @@index([lot_id, timestamp], name: "idx_snapshots_lot_time")
  @@index([lot_id, timestamp, semester, academic_period], name: "idx_snapshots_training")
  @@map("occupancy_snapshots")
}

model DeviceState {
  id              String    @id @default(cuid())
  device_hash     String
  lot_id          String
  last_event_type EventType
  updated_at      DateTime  @default(now())

  lot Lot @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@unique([device_hash, lot_id])
  @@map("device_states")
}

// ─── Campus Context Tables ────────────────────────────────

model Building {
  id              String   @id @default(cuid())
  school_id       String
  name            String
  alternate_names String[]
  /// Approximate centerpoint (degrees, WGS84). Used to compute proximity to lots / events.
  center_lat      Float
  center_lng      Float
  /// Optional outer-ring polygon (array of {lat,lng}) extracted from concept3d.
  /// Null when no authoritative footprint is available (e.g. small offices, off-campus venues).
  /// When present, used for point-to-edge proximity instead of haversine-to-centroid.
  footprint_polygon Json?
  /// Functional category — drives grouped display in lot info and other UIs.
  category        BuildingCategory @default(OTHER)
  created_at      DateTime @default(now())

  school        School        @relation(fields: [school_id], references: [id], onDelete: Cascade)
  lot_buildings LotBuilding[]
  campus_events CampusEvent[]

  @@unique([school_id, name])
  @@map("buildings")
}

model LotBuilding {
  lot_id      String
  building_id String

  lot      Lot      @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)

  @@id([lot_id, building_id])
  @@map("lot_buildings")
}

model CampusEvent {
  id          String   @id @default(cuid())
  school_id   String
  external_id String   @unique
  event_name  String
  location    String
  description String?
  event_url   String?
  building_id String?
  start_time  DateTime
  // Optional: sports games scraped from Sidearm only have a published start
  // time. The scraper leaves this null at create; refreshFinalScores backfills
  // it with the wall-clock moment the box score was published when status
  // flips SCHEDULED → FINAL. CampusLabs (academic / club) events always set a
  // real end_time from the source feed.
  end_time    DateTime?
  created_at  DateTime @default(now())

  // ── Live sports state ────────────────────────────────────
  // Populated by the sports scraper for LBSU home games. Null for
  // non-sports CampusLabs events. `status` is the canonical lifecycle
  // (SCHEDULED → LIVE → FINAL, plus POSTPONED/CANCELLED), derived from
  // Sidearm's `gameState` integer. Scores are strings on the wire
  // (Sidearm sends "16"/"" for not-yet-played) but normalised to ints
  // here so mobile/UI doesn't have to parse.
  status            SportsEventStatus?
  home_score        Int?
  away_score        Int?
  result_status     SportsResultStatus? // W/L/T, populated when status=FINAL
  status_updated_at DateTime?

  school            School            @relation(fields: [school_id], references: [id], onDelete: Cascade)
  building          Building?         @relation(fields: [building_id], references: [id], onDelete: SetNull)
  notification_logs NotificationLog[]

  @@index([building_id, start_time])
  // Live-events lookup: scan only currently-LIVE rows quickly. Partial-style
  // index via composite ordering — `status` first means a `WHERE status='LIVE'`
  // probe walks a tight slice instead of the full table.
  @@index([status, start_time])
  @@map("campus_events")
}

model Weather {
  id                        String   @id @default(cuid())
  school_id                 String
  timestamp                 DateTime
  temperature_f             Float
  feels_like_f              Float
  humidity_percent          Float
  wind_speed_mph            Float
  conditions                String
  precipitation_probability Float
  is_raining                Boolean
  created_at                DateTime @default(now())

  school              School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  occupancy_snapshots OccupancySnapshot[]

  @@index([school_id, timestamp])
  @@map("weather")
}

/// Hourly forecast rows from NWS api.weather.gov, written by the
/// `fetch-weather-forecast` cron every 6 hours. Each row represents one
/// future hour for a given school. The cron itself self-prunes rows whose
/// `target_time` is in the past before each upsert pass, so this table
/// never grows beyond the active forecast window.
model WeatherForecast {
  id                        String   @id @default(cuid())
  school_id                 String
  /// Start of the 1-hour window this forecast applies to (UTC).
  target_time               DateTime
  temperature_f             Float
  /// Stored as a 0-1 rate (NWS returns 0-100 percent; normalized on write).
  precipitation_probability Float
  /// Derived via short-forecast keyword + pop threshold; see deriveIsRaining.
  is_raining                Boolean
  wind_speed_mph            Float
  /// Lower-cased short-forecast text from NWS (e.g. "light rain").
  conditions                String
  /// When this forecast was retrieved from NWS (used for staleness gating).
  fetched_at                DateTime @default(now())

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)

  /// One forecast row per (school, target_time). New cron run upserts.
  /// (No separate @@index — the unique constraint above provides the index.)
  @@unique([school_id, target_time])
  @@map("weather_forecasts")
}

model Report {
  id         String     @id @default(cuid())
  lot_id     String
  user_id    String
  type       ReportType
  message    String?
  created_at DateTime   @default(now())

  lot        Lot        @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([lot_id, created_at], name: "idx_reports_lot_time")
  @@index([user_id, created_at], name: "idx_reports_user_time")
  @@map("reports")
}

// ─── ML Prediction Tables ─────────────────────────────────

model PredictionShortTerm {
  id              String   @id @default(cuid())
  lot_id          String
  predicted_at    DateTime
  target_time     DateTime
  predicted_occupancy Float   // rate [0, 1] — CHECK constraint in DB
  confidence_lower    Float
  confidence_upper    Float
  model_version   String

  lot Lot @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@index([lot_id, target_time], name: "idx_pred_short")
  @@map("predictions_short_term")
}

model PredictionLongTerm {
  id              String   @id @default(cuid())
  lot_id          String
  predicted_at    DateTime
  target_date     DateTime
  target_hour     Int      // 0-23
  predicted_occupancy Float   // rate [0, 1] — CHECK constraint in DB
  confidence_lower    Float
  confidence_upper    Float
  model_version   String

  lot Lot @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@index([lot_id, target_date, target_hour], name: "idx_pred_long")
  @@map("predictions_long_term")
}

// ─── Push Notifications ───────────────────────────────────

model PushToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  platform   String   // "ios" | "android"
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_tokens")
}

// Dedup log — prevents sending the same alert class to the same user twice.
// lot_id is set for lot-level triggers (FAVORITES_FILLING, FAVORITES_CLEARING).
// event_id is set for event triggers (EVENTS). Both are nullable with SetNull
// so deleting a lot or event doesn't cascade-delete historical log rows.
model NotificationLog {
  id       String           @id @default(cuid())
  user_id  String
  type     NotificationType
  lot_id   String?
  event_id String?
  sent_at  DateTime         @default(now())

  user  User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lot   Lot?         @relation(fields: [lot_id], references: [id], onDelete: SetNull)
  event CampusEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)

  @@index([user_id, type, sent_at], name: "idx_notification_log_dedup")
  @@map("notification_logs")
}

// ─── Audit log ────────────────────────────────────────────
// Append-only event log for compliance-relevant actions (account deletion,
// data export, etc.). actor_hash is SHA-256 of the email so the row carries
// no reversible PII after the user is deleted, satisfying GDPR right-to-erasure
// while still letting us prove "an account at this hash was deleted at T".

model AuditEvent {
  id          String         @id @default(cuid())
  event_type  AuditEventType
  actor_hash  String         // SHA-256(email + AUDIT_HASH_SALT)
  metadata    Json?          // event-type-specific structured fields, no PII
  created_at  DateTime       @default(now())

  @@index([event_type, created_at], name: "idx_audit_type_time")
  @@index([actor_hash, created_at], name: "idx_audit_actor_time")
  @@map("audit_events")
}

// ─── Reciprocity / contributor tracking ───────────────────
// Tracks which devices have recently sent occupancy events, so the
// ContributorGuard can grant access to live-occupancy / forecast endpoints
// only to devices that are actively contributing data. One row per device
// hash; bumped on every POST /occupancy-events (including deduplicated ones,
// which still prove the device is alive and reporting).

model ContributorPing {
  device_hash    String    @id           // SHA-256(salt:device_id) — same hash used in OccupancyEvent
  first_seen_at  DateTime  @default(now())
  last_seen_at   DateTime  @default(now())
  // Permission-grant grace pass. Set when the device confirms it has granted
  // location permissions but hasn't necessarily produced an occupancy event
  // yet (e.g. a fresh install on opening day). The ContributorGuard accepts a
  // request as long as EITHER `last_seen_at` is within CONTRIBUTOR_PING_TTL_MS
  // OR `granted_at` is within CONTRIBUTOR_GRANT_TTL_MS (24h by default). This
  // unblocks first-run UX without giving away unlimited free reads — the
  // grant expires unless the device starts contributing real events.
  granted_at     DateTime?

  @@index([last_seen_at], name: "idx_contributor_last_seen")
  @@index([granted_at],   name: "idx_contributor_granted_at")
  @@map("contributor_pings")
}

// ─── Lot advisories ───────────────────────────────────────
// Operational notices that affect a specific lot — construction zones,
// road closures, partial closures, etc. Sourced from the campus map
// (concept3d) by the extract-lot-advisories.ts script. Each external
// marker may produce multiple rows when one polygon overlaps several
// lots. Rows are upserted on (school_id, source, source_marker_id,
// lot_id) so re-running the extractor is idempotent. Stale markers
// removed from the source must be marked is_active=false (handled by
// the seeder when an existing row is no longer in the generated set).
model LotAdvisory {
  id                String           @id @default(cuid())
  school_id         String
  lot_id            String           // FK → Lot.id
  title             String
  description       String?
  severity          AdvisorySeverity
  source            AdvisorySource
  source_cat_id     Int              // concept3d catId
  source_marker_id  Int              // concept3d location.id
  /** Reason this advisory was attached to this lot. */
  match_reason      String           // "name_mention" | "polygon_overlap"
  /** Advisory's own footprint polygon (Array<{lat,lng}>). */
  polygon           Json
  starts_at         DateTime?
  ends_at           DateTime?
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  school            School           @relation(fields: [school_id], references: [id], onDelete: Cascade)
  lot               Lot              @relation(fields: [lot_id], references: [id], onDelete: Cascade)

  @@unique([school_id, source, source_marker_id, lot_id], name: "uq_lot_advisory_source_lot")
  @@index([lot_id, is_active], name: "idx_lot_advisory_lot_active")
  @@map("lot_advisories")
}

// ─── Enums ────────────────────────────────────────────────

enum LotType {
  STUDENT
  EMPLOYEE
}

enum UserType {
  STUDENT
  EMPLOYEE
}

enum EventType {
  ENTER
  EXIT
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportType {
  BLOCKAGE
  CRASH
  OTHER
}

enum AdvisorySeverity {
  INFO      // general notice (e.g. "coming in 2026")
  ADVISORY  // construction in/near lot, expect impact
  CLOSURE   // lot or access road closed
}

enum AdvisorySource {
  CONCEPT3D
}

enum BuildingCategory {
  ACADEMIC        // classroom buildings, faculty offices, libraries
  ADMINISTRATIVE  // admin offices, services, support facilities
  HOUSING         // residence halls and on-campus housing (non-public)
  RETAIL          // bookstore, cafes, convenience stores
  ATHLETIC        // athletics venues, performance halls, recreation
  OUTDOOR         // outdoor spaces (quads, fields not used as venues)
  OTHER           // misc / uncategorised
}

enum AuditEventType {
  USER_DELETED
  USER_DATA_EXPORTED
}

enum NotificationType {
  FAVORITES_FILLING  @map("favorites_filling")
  FAVORITES_CLEARING @map("favorites_clearing")
  SURGE              @map("surge")
  EVENTS             @map("events")
}

/// Lifecycle of a sports CampusEvent. Mapped from Sidearm's top-level
/// `status` flag and `result` payload at scrape time:
///   "A" + no result            → SCHEDULED
///   "O" + result.teamScore set → FINAL (result_status populated W/L/T)
///   gameStateDisplay POSTPONED → POSTPONED
///   gameStateDisplay CANCELLED → CANCELLED
///   noplayText populated       → CANCELLED
///
/// LIVE is reserved but intentionally NEVER written: the Sidearm calendar
/// API has no in-progress signal (`gameCenterEnabled` is always false and
/// no third top-level status value exists, verified across April + May
/// 2026 LBSU games). Per-sport live stats live on third-party sites and
/// are out of scope for the calendar scraper.
enum SportsEventStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELLED
}

/// Outcome of a FINAL sports event from the LBSU perspective. Mapped from
/// Sidearm's `result.status` ("W" / "L" / "T"). Only populated when
/// `status = FINAL`.
enum SportsResultStatus {
  W
  L
  T
}
