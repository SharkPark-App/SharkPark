---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-surface-soft)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2">
        <img src="/favicon.svg" alt="" aria-hidden="true" width="28" height="28" class="h-7 w-7 rounded-md" />
        <span class="text-base font-semibold">{SITE.name}</span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-[var(--color-muted)]">
        Independent, community-built parking app for the CSULB area. Not affiliated with, endorsed by, or sponsored by California State University, Long Beach.
      </p>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-muted)]">Product</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="hover:text-[var(--color-brand-600)]">Home</a></li>
        <li><a href="/support" class="hover:text-[var(--color-brand-600)]">Support &amp; FAQ</a></li>
        <li><a href={SITE.statusUrl} rel="noopener" class="hover:text-[var(--color-brand-600)]">Status</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-muted)]">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/privacy" class="hover:text-[var(--color-brand-600)]">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-[var(--color-brand-600)]">Terms of Service</a></li>
        <li><a href="/delete-account" class="hover:text-[var(--color-brand-600)]">Delete account</a></li>
        <li><a href={`mailto:${SITE.privacyEmail}`} class="hover:text-[var(--color-brand-600)]">{SITE.privacyEmail}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--color-border)]">
    <p class="mx-auto max-w-6xl px-6 py-5 text-xs text-[var(--color-muted)]">
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
