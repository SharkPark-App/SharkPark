# SharkPark mobile — local development overrides
#
# Copy this file to `.env` (which is gitignored) and uncomment / set values
# as needed. Values are inlined into the JS bundle at build time by
# react-native-dotenv (see babel.config.js).
#
# After changing .env you must restart Metro with --reset-cache:
#   pnpm --filter mobile start --reset-cache

# Override the API base URL. Useful when running the app on a physical device
# (the simulator/emulator defaults — localhost / 10.0.2.2 — won't reach your
# dev machine over the LAN). Find your machine IP with `node scripts/get-network-ip.js`.
#
# SHARKPARK_API_URL=http://192.168.1.42:3000/api/v1

# Sentry DSN for the mobile project (sharkpark-mobile). Leave unset locally
# to disable error reporting; CI injects this for release builds.
#
# SENTRY_DSN_MOBILE=https://<key>@<org>.ingest.us.sentry.io/<project>
# SENTRY_ENVIRONMENT=development

# Shared secret for the shuttle WebSocket handshake. Must match WS_CONNECT_SECRET
# on the backend. Leave unset locally — the gateway logs a warning and allows all
# connections when no secret is configured.
#
# WS_CONNECT_SECRET=<random-secret>
