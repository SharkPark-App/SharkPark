source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Pin to 1.16.2 — ensures Podfile.lock is generated consistently across all
# developer machines and CI. Using a loose range caused the lockfile to be
# regenerated with 1.15.2 on some machines, producing ~40 spurious hash diffs.
gem 'cocoapods', '1.16.2'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
# xcodeproj: the < 1.26.0 cap was a workaround for a CocoaPods 1.15.x bug;
# CocoaPods 1.16.2 requires xcodeproj >= 1.27.0, so the cap is removed.
gem 'concurrent-ruby', '< 1.3.8'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
