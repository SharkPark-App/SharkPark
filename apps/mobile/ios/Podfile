# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'mobile' do
  config = use_native_modules!

  # Required for react-native-app-auth with bridgeless mode
  pod 'AppAuth', :modular_headers => true

  # @react-native-firebase/* uses Swift internally; the underlying GoogleUtilities
  # pod ships without module maps, so cocoapods refuses to integrate it as a
  # static library unless we opt these targets into modular headers explicitly.
  # Without this, `pod install` fails with:
  #   "The Swift pod `FirebaseCoreInternal` depends upon `GoogleUtilities`,
  #    which does not define modules."
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt must be compiled w/ older C++ standard (e.g. v17)
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end

      # Xcode 16 enables "explicit modules" by default, which auto-generates
      # a clang modulemap per pod under
      # DerivedData/.../GeneratedModuleMaps-iphonesimulator/<Name>.modulemap.
      # For pods opted into `:modular_headers => true` (FirebaseCore,
      # FirebaseInstallations, etc.) CocoaPods *also* writes a modulemap to
      # Pods/Headers/Public/<Name>/<Name>.modulemap, and clang sees both →
      # "redefinition of module 'FirebaseCore'" → cascading "could not build
      # module Foundation" → Swift bridging-header PCH fails. Disable the
      # explicit-modules build path until upstream resolves the clash.
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end

    # Same flags on the umbrella Pods.xcodeproj-level configurations.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
          config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
      aggregate_target.user_project.save
    end

    # React Native (new architecture) writes its own clang modulemaps for
    # Firebase pods to DerivedData/.../GeneratedModuleMaps-iphonesimulator/
    # and injects them into the Swift compile via `-Xcc -fmodule-map-file=`.
    # Because we also opt FirebaseCore / FirebaseInstallations into
    # `:modular_headers => true` (required so cocoapods will integrate
    # FirebaseCoreInternal + GoogleUtilities), CocoaPods writes a *second*
    # modulemap to Pods/Headers/Public/<Name>/<Name>.modulemap and the
    # generated user-target xcconfig adds it to the same compile via another
    # `-Xcc -fmodule-map-file=`. clang then sees the same module declared
    # twice and fails:
    #
    #   error: redefinition of module 'FirebaseCore'
    #   error: redefinition of module 'FirebaseInstallations'
    #
    # which cascades into "could not build module Foundation" → bridging
    # header PCH failure → exit 65.
    #
    # Fix: leave the CocoaPods modulemaps on disk (they're needed so that
    # `@import FirebaseCore;` inside FirebaseInstallations still resolves
    # via normal modulemap discovery), but strip the explicit
    #   -Xcc -fmodule-map-file=${PODS_ROOT}/Headers/Public/<Name>/<Name>.modulemap
    # entries from the user xcconfigs so they aren't force-injected a second
    # time alongside the Generated-modulemap injection.
    duplicate_module_names = %w[FirebaseCore FirebaseInstallations]
    pods_xcconfig_glob = File.join(__dir__, 'Pods/Target Support Files/Pods-*/Pods-*.xcconfig')
    Dir.glob(pods_xcconfig_glob).each do |xcconfig_path|
      original = File.read(xcconfig_path)
      patched = original.dup
      duplicate_module_names.each do |mod|
        # CocoaPods writes each entry as:
        #   -Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/<Mod>/<Mod>.modulemap"
        # The path is *quoted*, so the regex MUST consume the surrounding
        # double-quotes (and any leading whitespace) — otherwise stripping
        # leaves a dangling `"` that fuses the next flag's value into this
        # one, producing nonsense paths like
        #   '.../FBLPromises/PromisesObjC.modulemap -Xcc -fmodule-map-file=.../FirebaseCoreExtension.modulemap'
        # and the build fails with "module map file ... not found".
        pattern = /\s*-Xcc\s+-fmodule-map-file=("?)[^"\s]*Headers\/Public\/#{Regexp.escape(mod)}\/#{Regexp.escape(mod)}\.modulemap\1/
        patched.gsub!(pattern, '')
      end
      next if patched == original
      Pod::UI.puts "Stripping duplicate -fmodule-map-file= from #{File.basename(xcconfig_path)}".yellow
      File.write(xcconfig_path, patched)
    end
    # ----------------------------
  end
end
