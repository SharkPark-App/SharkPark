# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://sharkpark:sharkpark@localhost:5433/sharkpark

# ── MLflow tracking + artifact store ────────────────────
# In production both the GitHub Actions training runner and the backend's
# Fly cron VM (which spawns Python inference scripts) must point at the SAME
# tracking URI and artifact location, otherwise inference can't load the
# model that training just promoted to @production.
#
# Recommended: use a DEDICATED Neon database for MLflow's tables (the client
# auto-creates ``mlruns_*`` schema on first connect). This keeps the app
# schema clean and lets Prisma migrations stay opinion-free.
MLFLOW_TRACKING_URI=postgresql+psycopg2://mlflow:<pw>@<host>/sharkpark_mlflow?sslmode=require

# Where MLflow writes run artifacts (models, plots, parquet snapshots). Combined
# with ML_R2_* below this lands in Cloudflare R2 via boto3's S3-compatible client.
MLFLOW_ARTIFACT_LOCATION=s3://sharkpark-ml-exports/mlflow-artifacts

# ── Cloudflare R2 (model artifact store + MLflow artifact store) ────────
# Used by promote_short_term.py / promote_long_term.py with --export-s3,
# AND by MLflow itself (mirrored into AWS_*/MLFLOW_S3_ENDPOINT_URL by
# src/utils/mlflow_setup.py at process start).
# Endpoint URL: Cloudflare dashboard → R2 → bucket → Settings → "S3 API".
# Token must have Object Read & Write permission on sharkpark-ml-exports.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
ML_R2_ACCESS_KEY_ID=
ML_R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sharkpark-ml-exports   # optional; default shown

# ── Optional toggles ────────────────────────────────────
# WEATHER_ADJUSTMENT_ENABLED=true
# WEATHER_MAX_AGE_HOURS=3
