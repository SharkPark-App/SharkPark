# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://sharkpark:sharkpark@localhost:5433/sharkpark

# ── Cloudflare R2 (model artifact store) ────────────────
# Used by promote_short_term.py / promote_long_term.py with --export-s3.
# Endpoint URL: Cloudflare dashboard → R2 → bucket → Settings → "S3 API".
# Token must have Object Read & Write permission on the bucket.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sharkpark-ml-exports   # optional; default shown

# ── Optional toggles ────────────────────────────────────
# WEATHER_ADJUSTMENT_ENABLED=true
# WEATHER_MAX_AGE_HOURS=3
